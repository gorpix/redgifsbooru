{
  "name": "redgifsbooru",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "An e621-style booru front end for RedGifs, as a userscript.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:local": "tsc --noEmit && vite build --mode dev",
    "watch": "vite build --watch",
    "watch:local": "vite build --watch --mode dev",
    "serve": "node serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "fake-indexeddb": "6.2.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-monkey": "8.1.1",
    "vitest": "5.0.5"
  }
}
